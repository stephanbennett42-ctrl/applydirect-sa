# ==========================================================================
# ApplyDirect-SA — unified root stack (student site + shared DB via setup.js)
# --------------------------------------------------------------------------
# Copy this file to `.env` and put YOUR real values in (never commit .env):
#     copy backend\.env.example backend\.env
# Then on Windows run:   node start.js
#
# Every teammate uses ONE shared database; setup.js creates it if missing
# and seeds it idempotently (safe to run every boot). Your only real job is
# the two DB_* lines below.
# ==========================================================================

# --- MySQL / MariaDB (XAMPP default skips the port+password if left blank) ---
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
# Leave empty for XAMPP's default passwordless root
DB_PASSWORD=
DB_NAME=sa_tertiary_db

# --- Launcher / HTTP ---
PORT=3000

# --- Email (optional; contact form saves to the DB either way) ---
EMAIL_USER=
EMAIL_APP_PASSWORD=
